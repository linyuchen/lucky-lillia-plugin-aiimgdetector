{
  "name": "lucky-lillia-plugin-aiimgdetector",
  "version": "1.0.3",
  "description": "Checks AI image provenance through OpenAI, optional SynthID detection, and a vision model",
  "author": "linyuchen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linyuchen/lucky-lillia-plugin-aiimgdetector.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "webui",
    "src",
    "assets",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p . && node scripts/copy-synthid-http-runtime-lib.mjs",
    "dev": "tsc -p . --watch",
    "test": "vitest run",
    "test:runtime": "node scripts/smoke-synthid-runtime.mjs",
    "test:browser": "node test/synthid-browser.mjs && node test/synthid-native-proxy.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "luckylillia-plugin"
  ],
  "dependencies": {
    "@contentauth/toolkit": "0.13.14",
    "acorn": "8.15.0",
    "cssstyle": "4.6.0",
    "jsdom": "26.1.0",
    "parse5": "7.3.0",
    "playwright-core": "^1.65.0",
    "tough-cookie": "5.1.2",
    "whatwg-url": "14.2.0"
  },
  "peerDependencies": {
    "@luckylillia/plugin-aiprovider": "^1.0.0",
    "@luckylillia/plugin-sdk": "^1.0.1"
  },
  "devDependencies": {
    "@luckylillia/plugin-aiprovider": "^1.0.0",
    "@luckylillia/plugin-sdk": "^1.0.1",
    "@types/node": "^24.12.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "llbot": {
    "webui": "webui/index.js",
    "title": {
      "zh": "AI 图片检测",
      "en": "aiimgdetector"
    },
    "category": "chat",
    "description": "对着图片回复「ai吗」（或者「ai吗」后面直接带图），通过 OpenAI 水印检测、可选的 SynthID 检测和看图模型判断是否由 AI 生成。",
    "icon": "assets/icon.svg",
    "screenshots": [
      "assets/demo.png"
    ],
    "dependencies": {
      "@luckylillia/plugin-aiprovider": "^1.0.0"
    },
    "service": {
      "required": [
        "bots",
        "ai",
        "http",
        "commands"
      ]
    }
  }
}
